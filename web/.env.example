# Copy to .env.local.

# --- Supabase (Dashboard -> Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Cloudflare R2 media storage ---
# Account ID: Cloudflare dashboard -> R2 -> Overview (right sidebar).
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Create token with "Object Read & Write",
# scoped to the bucket below. Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chat-media
# Public hostname serving the bucket (custom domain or r2.dev URL), no trailing slash.
# Public by design: the browser builds image URLs from it.
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=media.example.com

# --- Agora RTC voice calls (console.agora.io -> Project -> Config) ---
# The project must use "Secured mode: APP ID + Token". Both are server-only:
# the App ID is returned to the browser with each token from /api/agora/token.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
